# Normalize line endings for text files.
* text=auto eol=lf

# Ship only addons/terrain_tool/ in Godot Asset Library downloads.
# Everything else (standalone app files, tests, docs) is excluded
# from the generated zip archive.
/.gitattributes         export-ignore
/.gitignore             export-ignore
/LICENSE                export-ignore
/README.md              export-ignore
/icon.png               export-ignore
/icon.png.import        export-ignore
/project.godot          export-ignore
/main.gd                export-ignore
/main.gd.uid            export-ignore
/main.tscn              export-ignore
/export_presets.cfg     export-ignore
/docs/**                export-ignore
/tests/**               export-ignore
/export/**              export-ignore
